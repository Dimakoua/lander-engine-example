{
  "header": {
    "component": "Navbar",
    "props": {
      "brandName": "SaaSify Demo for {{ companyName }}",
      "links": [
        {
          "label": "Home",
          "action": [
            {
              "type": "ui",
              "payload": {
                "operation": "goToNextStep",
                "params": {
                  "next": "main"
                }
              }
            }
          ]
        },
        {
          "label": "Showcase",
          "action": [
            {
              "type": "ui",
              "payload": {
                "operation": "goToNextStep",
                "params": {
                  "next": "actions-showcase"
                }
              }
            }
          ]
        }
      ],
      "ctaText": "Contact Us",
      "onCtaClick": [
        {
          "type": "ui",
          "payload": {
            "operation": "openPopup",
            "params": {
              "popupId": "secondary"
            }
          }
        }
      ]
    }
  },
  "footer": {
    "component": "Footer",
    "props": {
      "brandName": "Thank You from {{ companyName }}!",
      "description": "Building the future of configuration-driven landing pages.",
      "links": [
        {
          "label": "Main Page",
          "action": [
            {
              "type": "ui",
              "payload": {
                "operation": "goToNextStep",
                "params": {
                  "next": "main"
                }
              }
            }
          ]
        },
        {
          "label": "Showcase",
          "action": [
            {
              "type": "ui",
              "payload": {
                "operation": "goToNextStep",
                "params": {
                  "next": "actions-showcase"
                }
              }
            }
          ]
        }
      ]
    }
  }
}